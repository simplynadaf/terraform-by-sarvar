# Terraform files
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars are normally ignored, but educational examples in articles/ are tracked intentionally
# (e.g., articles/05-variables-outputs/terraform/*.tfvars)
*.tfvars

# Article content (published on dev.to, not stored in repo)
# Only README.md files are tracked for navigation
articles/*/article.md
articles/*/article-original.md
articles/*/APPROACH.md
articles/*/TESTING_RESULTS.md
articles/*/TESTING_STEPS.md
articles/*/TESTING_STATUS.md
articles/*/SUMMARY.md

# Root-level internal docs (not for public repo)
ARTICLE_STYLE_GUIDE.md
TESTING_GUIDE.md
WORKFLOW.md
PROJECT_SETUP.md
FUTURE_SERIES_IDEAS.md

# Sensitive files
*.pem
*.key
*.pub
.env
secrets/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
